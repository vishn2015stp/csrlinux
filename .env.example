# Copy to .env on the Debian server (deploy/install.sh does this for you).
# PostgreSQL connection string used by server/db.js.
DATABASE_URL=postgresql://csrlinux:CHANGE_ME@127.0.0.1:5432/csrlinux

# Hosted databases (Supabase) use TLS, a local PostgreSQL install does not.
# Override auto-detection with DB_SSL=1 (on) or DB_SSL=0 (off).
DB_SSL=0
DB_POOL_MAX=5

# Port the Express server listens on (serves both /api and the React app).
PORT=3001
NODE_ENV=production
